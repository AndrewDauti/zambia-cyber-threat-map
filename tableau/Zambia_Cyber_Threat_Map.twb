<?xml version='1.0' encoding='utf-8'?>
<workbook original-version="18.1" source-build="2025.3.1 (20253.25.1210.1815)" source-platform="win" version="18.1" xmlns:user="http://www.tableausoftware.com/xml/user">
  <preferences />
  <datasources>
    <datasource caption="kpis.csv" inline="true" name="federated.kpis" version="18.1">
      <connection class="federated">
        <named-connections>
          <named-connection caption="kpis.csv" name="textscan.kpis">
            <connection class="textscan" directory="data" filename="kpis.csv" password="" server="" />
          </named-connection>
        </named-connections>
        <relation connection="textscan.kpis" name="kpis.csv" table="[kpis#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator=",">
            <column datatype="integer" name="kev_entries" ordinal="0" />
            <column datatype="real" name="ransomware_known_percent" ordinal="1" />
            <column datatype="integer" name="dshield_zambia_sources" ordinal="2" />
            <column datatype="integer" name="zambia_ransomware_victims" ordinal="3" />
            <column datatype="integer" name="africa_ransomware_victims" ordinal="4" />
          </columns>
        </relation>
        <cols>
          <map key="[kev_entries]" value="[kpis.csv].[kev_entries]" />
          <map key="[ransomware_known_percent]" value="[kpis.csv].[ransomware_known_percent]" />
          <map key="[dshield_zambia_sources]" value="[kpis.csv].[dshield_zambia_sources]" />
          <map key="[zambia_ransomware_victims]" value="[kpis.csv].[zambia_ransomware_victims]" />
          <map key="[africa_ransomware_victims]" value="[kpis.csv].[africa_ransomware_victims]" />
        </cols>
      </connection>
      <aliases enabled="yes" />
      <column datatype="integer" name="[kev_entries]" role="measure" type="quantitative" />
      <column datatype="real" name="[ransomware_known_percent]" role="measure" type="quantitative" />
      <column datatype="integer" name="[dshield_zambia_sources]" role="measure" type="quantitative" />
      <column datatype="integer" name="[zambia_ransomware_victims]" role="measure" type="quantitative" />
      <column datatype="integer" name="[africa_ransomware_victims]" role="measure" type="quantitative" />
    </datasource>
    <datasource caption="africa_ransomware_by_country.csv" inline="true" name="federated.africa" version="18.1">
      <connection class="federated">
        <named-connections>
          <named-connection caption="africa_ransomware_by_country.csv" name="textscan.africa_ransomware_by_country">
            <connection class="textscan" directory="data" filename="africa_ransomware_by_country.csv" password="" server="" />
          </named-connection>
        </named-connections>
        <relation connection="textscan.africa_ransomware_by_country" name="africa_ransomware_by_country.csv" table="[africa_ransomware_by_country#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator=",">
            <column datatype="string" name="iso2" ordinal="0" />
            <column datatype="string" name="country" ordinal="1" />
            <column datatype="integer" name="victim_count" ordinal="2" />
          </columns>
        </relation>
        <cols>
          <map key="[iso2]" value="[africa_ransomware_by_country.csv].[iso2]" />
          <map key="[country]" value="[africa_ransomware_by_country.csv].[country]" />
          <map key="[victim_count]" value="[africa_ransomware_by_country.csv].[victim_count]" />
        </cols>
      </connection>
      <aliases enabled="yes" />
      <column datatype="string" name="[iso2]" role="dimension" type="nominal" semantic-role="[Country].[ISO3166_2]" />
      <column datatype="string" name="[country]" role="dimension" type="nominal" />
      <column datatype="integer" name="[victim_count]" role="measure" type="quantitative" />
      <column datatype="real" hidden="true" name="[Latitude (generated)]" role="measure" semantic-role="[Geographical].[Latitude]" type="quantitative" />
      <column datatype="real" hidden="true" name="[Longitude (generated)]" role="measure" semantic-role="[Geographical].[Longitude]" type="quantitative" />
    </datasource>
